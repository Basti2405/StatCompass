# ---------------------------------------------------------------------------
# Ladereihenfolge: Sprachen zuerst, dann Daten, Logik, Oberflaeche, Core.
# Grund: Core startet beim Login alles auf - da muss der Rest schon da sein.
# ---------------------------------------------------------------------------

# Sprachdateien. enUS ist die Grundlage und muss vollstaendig sein; alles
# Weitere ueberschreibt nur einzelne Schluessel.
Locales\enUS.lua
Locales\deDE.lua

# Bruecke zu den WoW-Schnittstellen. Muss vor den Daten stehen, weil schon
# Daten\Ratings.lua die Combat-Rating-Konstanten von hier bezieht.
Logik\Kompat.lua

# Reine Daten - hier wird nichts berechnet. Das sind die Dateien, die bei
# einem neuen Patch angefasst werden (oder per Update-Paket ueberschrieben).
Daten\Ratings.lua
Daten\Breakpoints.lua

# Logik - liest Spielerwerte, rechnet, verwaltet Update-Pakete.
Logik\Datenpaket.lua
Logik\Rechner.lua
Logik\Spielerwerte.lua
Logik\ImportExport.lua

# Selbstdiagnose - beantwortet  /statcompass doctor . Braucht alles darueber.
Logik\Diagnose.lua

# Oberflaeche.
UI\Fenster.lua
UI\UpdateDialog.lua

Core.lua
